{"batchcomplete":"","query":{"pages":{"142191115":{"pageid":142191115,"ns":6,"title":"File:Minato City, Tokyo, Japan.jpg","index":2,"imagerepository":"local","imageinfo":[{"size":6227354,"width":5995,"height":3372,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Minato_City%2C_Tokyo%2C_Japan.jpg/960px-Minato_City%2C_Tokyo%2C_Japan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":360,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Minato_City%2C_Tokyo%2C_Japan.jpg/1280px-Minato_City%2C_Tokyo%2C_Japan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Minato_City%2C_Tokyo%2C_Japan.jpg/960px-Minato_City%2C_Tokyo%2C_Japan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":360,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Minato_City%2C_Tokyo%2C_Japan.jpg/1280px-Minato_City%2C_Tokyo%2C_Japan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/3/35/Minato_City%2C_Tokyo%2C_Japan.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Minato_City,_Tokyo,_Japan.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=142191115","extmetadata":{"ImageDescription":{"value":"A wide-angle landscape photograph of the Tokyo skyline captured during the \"golden hour.\" The image features a dense concentration of skyscrapers in the Minato ward. The iconic <a href=\"https://en.wikipedia.org/wiki/Tokyo_Tower\" class=\"extiw\" title=\"w:Tokyo Tower\">Tokyo Tower</a>, a communications and observation tower inspired by the Eiffel Tower, stands prominently in the center with its distinctive white and international orange lattice. To the left is the <a href=\"https://en.wikipedia.org/wiki/Roppongi_Hills\" class=\"extiw\" title=\"w:Roppongi Hills\">Roppongi Hills</a> and <a href=\"https://en.wikipedia.org/wiki/Azabudai_Hills\" class=\"extiw\" title=\"w:Azabudai Hills\">Azabudai Hills</a>. Taken from <a href=\"https://en.wikipedia.org/wiki/Shibuya_Stream\" class=\"extiw\" title=\"w:Shibuya Stream\">Shibuya Stream</a>'s 35th floor.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"4 December 2023, 16:08:46","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"David Kernan","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/4.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]},"179962435":{"pageid":179962435,"ns":6,"title":"File:Tokyo Tower, Minato City.jpg","index":1,"imagerepository":"local","imageinfo":[{"size":14324929,"width":5991,"height":3370,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Tokyo_Tower%2C_Minato_City.jpg/960px-Tokyo_Tower%2C_Minato_City.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":360,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Tokyo_Tower%2C_Minato_City.jpg/1280px-Tokyo_Tower%2C_Minato_City.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Tokyo_Tower%2C_Minato_City.jpg/960px-Tokyo_Tower%2C_Minato_City.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":360,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Tokyo_Tower%2C_Minato_City.jpg/1280px-Tokyo_Tower%2C_Minato_City.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/6/6d/Tokyo_Tower%2C_Minato_City.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Tokyo_Tower,_Minato_City.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=179962435","extmetadata":{"ImageDescription":{"value":"A high-angle night photograph of <a href=\"https://en.wikipedia.org/wiki/Tokyo\" class=\"extiw\" title=\"w:Tokyo\">Tokyo</a>, Japan. The <a href=\"https://en.wikipedia.org/wiki/Tokyo_Tower\" class=\"extiw\" title=\"w:Tokyo Tower\">Tokyo Tower</a> is prominently illuminated in its traditional orange \"Landmark Light.\" To the left, several modern skyscrapers are visible, including the <a href=\"https://en.wikipedia.org/wiki/Azabudai_Hills\" class=\"extiw\" title=\"w:Azabudai Hills\">Azabudai Hills</a> Mori JP Tower and the <a href=\"https://en.wikipedia.org/wiki/Roppongi_Hills\" class=\"extiw\" title=\"w:Roppongi Hills\">Roppongi Hills</a> Mori Tower. The foreground and background are filled with a dense grid of lower-rise buildings and residential blocks, creating a tapestry of urban lights. The atmosphere is clear, showing the vast scale of the metropolis at night. Taken from the 35th floor of <a href=\"https://en.wikipedia.org/wiki/Shibuya_Stream\" class=\"extiw\" title=\"w:Shibuya Stream\">Shibuya Stream</a>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2025-12-03 08:04:36","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Davekern\" title=\"User:Davekern\">David Kernan</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/4.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]}}}}