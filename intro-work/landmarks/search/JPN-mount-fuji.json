{"batchcomplete":"","continue":{"gsroffset":6,"continue":"gsroffset||"},"query":{"pages":{"2987529":{"pageid":2987529,"ns":6,"title":"File:CVW-5 Apr2007.jpg","index":5,"imagerepository":"local","imageinfo":[{"size":1283527,"width":4288,"height":2848,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/CVW-5_Apr2007.jpg/960px-CVW-5_Apr2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":425,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/CVW-5_Apr2007.jpg/1280px-CVW-5_Apr2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/CVW-5_Apr2007.jpg/960px-CVW-5_Apr2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":425,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/81/CVW-5_Apr2007.jpg/1280px-CVW-5_Apr2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/81/CVW-5_Apr2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:CVW-5_Apr2007.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=2987529","extmetadata":{"ImageDescription":{"value":"Aircraft assigned to <i>Carrier Air Wing Five (CVW-5)</i> perform a formation flight in front of Mount Fuji, Japan on 12 April 2007. CVW-5 was embarked aboard the carrier USS <i>Kitty Hawk</i> (CV-63). The carrier operated from Fleet Activities Yokosuka, Japan. Visible aircraft are (from left to right): Grumman E-2C NP <i>Hawkeye</i> (VAW-113 <i>Liberty Bells</i>), Grumman C-2A <i>Greyhound</i> (VRC-30, Det. 5 <i>Passwords</i>), Grumman EA-6B <i>Prowler</i> (VAQ-136 <i>Gauntlets</i>), McDonnellDouglas F/A-18F <i>Super Hornet</i> (VFA-102 <i>Diamondbacks</i>), F/A-18E <i>Super Hornet</i> (VFA-27 <i>Royal Maces</i>), F/A-18C(N) <i>Hornet</i> (VFA-192 <i>Golden Dragons</i>), and a F/A-18C(N) <i>Hornet</i> (VFA-195 <i>Dambusters</i>).","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a012 April 2007","source":"commons-desc-page"},"Credit":{"value":"<table class=\"layouttemplate sourcetemplate\" style=\"width:100%; clear:both; text-align:center; margin:0.5em auto; box-sizing: border-box; padding: 0; border-spacing: 8px; background-color: var(--background-color-neutral-subtle, #f6f7f5); color: var(--color-base, #202122); border: var(--border-subtle, 1px solid #555555);\" dir=\"ltr\" lang=\"en\">\n\n<tbody><tr>\n<td><span typeof=\"mw:File\"><span><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/09/Seal_of_the_United_States_Department_of_the_Navy.svg/120px-Seal_of_the_United_States_Department_of_the_Navy.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"80\" class=\"mw-file-element\" srcset=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/09/Seal_of_the_United_States_Department_of_the_Navy.svg/250px-Seal_of_the_United_States_Department_of_the_Navy.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"889\" data-file-height=\"889\"></span></span>\n</td>\n<td align=\"center\">\n<p><span class=\"layouttemplateargs\" style=\"display:none;speak:none;\" title=\"template=ID-USMil 1%3D070412-N-8591H-066 2%3DNavy url%3Dhttp%3A%2F%2Fwww.navy.mil%2Fview_image.asp%3Fid%3D45190\">\u00a0</span>\nThis image was released by the United States Navy with the <a href=\"//commons.wikimedia.org/wiki/Commons:VIRIN\" title=\"Commons:VIRIN\">ID</a> <a rel=\"nofollow\" class=\"external text\" href=\"http://www.navy.mil/view_image.asp?id=45190\">070412-N-8591H-066</a> <a class=\"external text\" data