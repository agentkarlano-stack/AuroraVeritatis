{"batchcomplete":"","query":{"pages":{"61865237":{"pageid":61865237,"ns":6,"title":"File:Bonn, Post-Tower -- 2017 -- 2128 (bw).jpg","index":4,"imagerepository":"local","imageinfo":[{"size":7165273,"width":5472,"height":3648,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Bonn%2C_Post-Tower_--_2017_--_2128_%28bw%29.jpg/960px-Bonn%2C_Post-Tower_--_2017_--_2128_%28bw%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":427,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Bonn%2C_Post-Tower_--_2017_--_2128_%28bw%29.jpg/1280px-Bonn%2C_Post-Tower_--_2017_--_2128_%28bw%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Bonn%2C_Post-Tower_--_2017_--_2128_%28bw%29.jpg/960px-Bonn%2C_Post-Tower_--_2017_--_2128_%28bw%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":427,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Bonn%2C_Post-Tower_--_2017_--_2128_%28bw%29.jpg/1280px-Bonn%2C_Post-Tower_--_2017_--_2128_%28bw%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/fe/Bonn%2C_Post-Tower_--_2017_--_2128_%28bw%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Bonn,_Post-Tower_--_2017_--_2128_(bw).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=61865237","extmetadata":{"ImageDescription":{"value":"<a href=\"https://en.wikipedia.org/wiki/Post_Tower\" class=\"extiw\" title=\"en:Post Tower\">Post Tower</a>, <a href=\"https://en.wikipedia.org/wiki/Bonn\" class=\"extiw\" title=\"en:Bonn\">Bonn</a>, <a href=\"https://en.wikipedia.org/wiki/North_Rhine-Westphalia\" class=\"extiw\" title=\"en:North Rhine-Westphalia\">North Rhine-Westphalia</a>, Germany<br><small>The Post Tower is the tallest building in Bonn and a landmark of the modern federal district. After the parliament and government moved to <a href=\"https://en.wikipedia.org/wiki/Berlin\" class=\"extiw\" title=\"en:Berlin\">Berlin</a>, Bonn developed into the headquarters of international organizations and large companies.<br>At the end of the 1990s, <a href=\"https://en.wikipedia.org/wiki/Deutsche_Post\" class=\"extiw\" title=\"en:Deutsche Post\">Deutsche Post</a> DHL Group decided to establish its corporate headquarters here. Construction began in 2000 based on plans by architect Helmut Jahn. The glass tower, which is approximately 162 meters high, was completed in 2002. Its striking double facade and transparent architecture are intended to symbolize openness and internationality.<br>The Post Tower represents Bonn\u2019s economic transformation from the former federal capital to an important service and UN location.</small>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a020 August 2017, 14:25","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q34788025\" class=\"extiw\" title=\"d:Q34788025\"><span title=\"German photographer and mathematician\">Dietmar Rabich</span></a></bdi>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]},"84954222":{"pageid":84954222,"ns":6,"title":"File:Canberra (AU), Commonwealth Avenue Bridge -- 2019 -- 1811.jpg","index":5,"imagerepository":"local","imageinfo":[{"size":15581027,"width":6647,"height":4431,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Canberra_%28AU%29%2C_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg/960px-Canberra_%28AU%29%2C_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":427,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Canberra_%28AU%29%2C_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg/1280px-Canberra_%28AU%29%2C_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Canberra_%28AU%29%2C_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg/960px-Canberra_%28AU%29%2C_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":427,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Canberra_%28AU%29%2C_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg/1280px-Canberra_%28AU%29%2C_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/b/b9/Canberra_%28AU%29%2C_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Canberra_(AU),_Commonwealth_Avenue_Bridge_--_2019_--_1811.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=84954222","extmetadata":{"ImageDescription":{"value":"Commonwealth Avenue Bridge, <a href=\"https://en.wikipedia.org/wiki/Canberra\" class=\"extiw\" title=\"en:Canberra\">Canberra</a>, <a href=\"https://en.wikipedia.org/wiki/Australian_Capital_Territory\" class=\"extiw\" title=\"en:Australian Capital Territory\">Australian Capital Territory</a>, Australia<br><small>The Commonwealth Avenue Bridge connects Canberra\u2019s city center with <a href=\"https://en.wikipedia.org/wiki/Parliament_House,_Canberra\" class=\"extiw\" title=\"en:Parliament House, Canberra\">Parliament House</a> across Lake Burley Griffin. It was completed in 1963, even before the artificial lake was completely flooded, replacing an earlier, lower bridge.<br>With the construction of the lake\u2014a central element of Walter Burley Griffin\u2019s city plan\u2014the bridge took on great urban significance. Designed as a modern prestressed concrete structure with clean lines, it has since become a defining feature of the capital\u2019s main axis.</small>","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a020 October 2019, 17:58","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<bdi><a href=\"https://www.wikidata.org/wiki/Q34788025\" class=\"extiw\" title=\"d:Q34788025\"><span title=\"German photographer and mathematician\">Dietmar Rabich</span></a></bdi>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]},"42506948":{"pageid":42506948,"ns":6,"title":"File:HUN-2015-Budapest-Hungarian Parliament (Budapest) 2015-02.jpg","index":2,"imagerepository":"local","imageinfo":[{"size":21297378,"width":8328,"height":4685,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/ba/HUN-2015-Budapest-Hungarian_Par