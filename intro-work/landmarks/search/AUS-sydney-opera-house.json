.wikimedia.org/wiki/User:Benh\" title=\"User:Benh\">Benh LIEU SONG</a> (<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/75729488@N03\">Flickr</a>)","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]},"62941151":{"pageid":62941151,"ns":6,"title":"File:Sydneyoperahouse at night.jpg","index":4,"imagerepository":"local","imageinfo":[{"size":13502962,"width":5831,"height":3692,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Sydneyoperahouse_at_night.jpg/960px-Sydneyoperahouse_at_night.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":405,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Sydneyoperahouse_at_night.jpg/1280px-Sydneyoperahouse_at_night.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Sydneyoperahouse_at_night.jpg/960px-Sydneyoperahouse_at_night.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":405,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Sydneyoperahouse_at_night.jpg/1280px-Sydneyoperahouse_at_night.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/c/cd/Sydneyoperahouse_at_night.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Sydneyoperahouse_at_night.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=62941151","extmetadata":{"ImageDescription":{"value":"<a href=\"https://en.wikipedia.org/wiki/Sydney_Opera_House\" class=\"extiw\" title=\"en:Sydney Opera House\">Sydney Opera House</a> at night. I took this image during the 2016 Sydney Vivid Festival. I stood in the middle of the <a href=\"https://en.wikipedia.org/wiki/Sydney_Harbour_Bridge\" class=\"extiw\" title=\"en:Sydney Harbour Bridge\">Sydney Harbour Bridge</a> for this 32 second exposure. The vantage point was excellent but it\u2019s also the shakiest part of the bridge for this long exposure, every time a large truck or a train went past it ruined the shot with vibrations. It took around 20 attempts until I finally had a 32 second window that was relatively free of vibrations. The camera battery died straight after I captured this image. I am deeply honoured to be the first Australian to become a finalist in the - Wiki Loves Monuments Picture of the Year 2017 with this photo. Feel free to download it - it belongs to the world now.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2016-06-16 23:44:38","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:Alphacontrol&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:Alphacontrol (page does not exist)\">Thomas Adams</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]}}}}