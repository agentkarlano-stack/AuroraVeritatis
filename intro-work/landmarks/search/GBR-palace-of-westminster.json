mageinfo":[{"size":69427051,"width":11719,"height":17554,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Elizabeth_Tower_2014-09-21_205MP.jpg/960px-Elizabeth_Tower_2014-09-21_205MP.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":959,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Elizabeth_Tower_2014-09-21_205MP.jpg/1280px-Elizabeth_Tower_2014-09-21_205MP.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Elizabeth_Tower_2014-09-21_205MP.jpg/960px-Elizabeth_Tower_2014-09-21_205MP.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":959,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Elizabeth_Tower_2014-09-21_205MP.jpg/1280px-Elizabeth_Tower_2014-09-21_205MP.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/1/14/Elizabeth_Tower_2014-09-21_205MP.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Elizabeth_Tower_2014-09-21_205MP.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=35594765","extmetadata":{"ImageDescription":{"value":"<a href=\"https://en.wikipedia.org/wiki/Elizabeth_Tower\" class=\"extiw\" title=\"en:Elizabeth Tower\">Elizabeth Tower</a> (Big Ben) from the dome on <a href=\"https://en.wikipedia.org/wiki/Methodist_Central_Hall_Westminster\" class=\"extiw\" title=\"en:Methodist Central Hall Westminster\">Methodist Central Hall</a>. The tower is 96m high. <a href=\"https://en.wikipedia.org/wiki/The_Shard\" class=\"extiw\" title=\"en:The Shard\">The Shard</a>, behind, is 306m.\n<br><b>Photographer's notes:</b> The image is stitched from 57 frames in approximately ten rows of six in landscape orientation. The viewpoint is the platform near the top of the dome on the Methodist Central Hall which is equal in height to the bottom of the clock face, and 400m distant. A Sony A77II camera was used with Sony 55-300mm lens at 300mm. The exposure was f/5.6, 1/500s and ISO 320. The camera has hand-held. The dome is only open to the public once a year on <a href=\"https://en.wikipedia.org/wiki/Open_House_London\" class=\"extiw\" title=\"en:Open House London\">Open House London</a> weekend. This viewpoint is rare in that most ground-level views suffer from vertical perspective distortions and most distant or elevated views are somewhat obstructed.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2014-09-21 16:23:49","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Colin\" title=\"User:Colin\">Colin</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"}},"mime":"image/jpeg"}]},"1634181":{"pageid":1634181,"ns":6,"title":"File:Palace of Westminster, London - Feb 2007.jpg","index":1,"imagerepository":"local","imageinfo":[{"size":1029464,"width":3200,"height":1261,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/97/Palace_of_Westminster%2C_London_-_Feb_2007.jpg/960px-Palace_of_Westminster%2C_London_-_Feb_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":640,"thumbheight":252,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/97/Palace_of_Westminster%2C_London_-_Feb_2007.jpg/1280px-Palace_of_Westminster%2C_London_-_Feb_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/97/Palace_of_Westminster%2C_London_-_Feb_2007.jpg/960px-Palace_of_Westminster%2C_London_-_Feb_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":640,"height":252,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/97/Palace_of_Westminster%2C_London_-_Feb_2007.jpg/1280px-Palace_of_Westminster%2C_London_-_Feb_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/9/97/Palace_of_Westminster%2C_London_-_Feb_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Palace_of_Westminster,_London_-_Feb_2007.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=1634181","extmetadata":{"ImageDescription":{"value":"The <a href=\"//commons.wikimedia.org/wiki/Palace_of_Westminster\" title=\"Palace of Westminster\">Palace of Westminster</a> at night as seen from the opposite side of the <a href=\"//commons.wikimedia.org/wiki/Category:Thames\" class=\"mw-disambig\" title=\"Category:Thames\">River Thames</a>. Victoria Tower and the House of Lords is on the left. The Clock Tower of Big Ben and the House of Commons is on the right. The spire left of centre is the 300ft ventilation chimney above the central lobby. The twin towers with flagless pole just visible in the background is <a href=\"//commons.wikimedia.org/wiki/Westminster_Abbey\" title=\"Westminster Abbey\">Westminster Abbey</a>. A 2 x 6 segment panoramic image taken by myself with a Canon 5D and 85mm f/1.8 lens.","source":"commons-desc-page"},"DateTimeOriginal":{"valu