{
  // Aurora Veritatis — Cloudflare Workers configuration.
  // Static SPA served by Workers Static Assets; /api/* handled by the Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora-veritatis",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Production custom domain (aurorav.app) is intentionally NOT configured here.
  // Add it only after review — see docs/DEPLOYMENT.md.
  "workers_dev": true,
  "preview_urls": true,
  // SUPABASE_URL and SUPABASE_ANON_KEY are set in the Cloudflare dashboard (or .dev.vars locally),
  // never committed. keep_vars stops deploys from wiping dashboard-managed variables.
  "keep_vars": true,
  "vars": {
    "APP_ENV": "preview",
    "APP_VERSION": "0.1.0"
  }
}
